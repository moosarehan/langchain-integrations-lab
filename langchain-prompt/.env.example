# Example environment variables for langchain-prompt
# Copy this file to .env and fill values (do NOT commit .env)

# Hugging Face Hub API token (required for HuggingFace endpoint usage)
HUGGINGFACEHUB_API_TOKEN="your_huggingface_api_token_here"

# Example: If you use OpenAI or Google, add placeholders here too
#OPENAI_API_KEY="your_openai_api_key_here"
#GOOGLE_API_KEY="your_google_api_key_here"

# Any other project-specific secrets can be added below as placeholders
